DB_USER=weather
DB_PASSWORD=weather
DB_NAME=weatherml
DB_HOST=db
DB_PORT=5432

OPENWEATHER_API_KEY=

INGEST_BACKFILL_YEARS=2
INGEST_CURRENT_INTERVAL_MIN=60
INGEST_FORECAST_INTERVAL_HOURS=6

# --- Production deploy (used by docker-compose.prod.yml + Caddyfile) ---
# Base hostname. With nip.io / sslip.io no DNS setup is needed:
#   DOMAIN_BASE=<your-vps-public-ip>.nip.io
# Will expose:
#   https://weather.<DOMAIN_BASE>/   (Streamlit dashboard)
#   https://api.<DOMAIN_BASE>/docs   (FastAPI Swagger)
DOMAIN_BASE=localhost
# Email for Let's Encrypt notifications (optional, expiry alerts only)
LETSENCRYPT_EMAIL=admin@localhost
